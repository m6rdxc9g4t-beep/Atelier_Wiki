{
  "name": "@atelier-wiki/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API du Wiki (Fastify + TypeScript + SQLite/FTS5).",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
